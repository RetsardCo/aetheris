{
  "name": "ai-activity-visualizer",
  "displayName": "Aetheris",
  "description": "Aetheris - 3D Cognitive Observatory for Autonomous AI Agents",
  "version": "1.0.0",
  "publisher": "kurados",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RetsardCo/aetheris"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Machine Learning"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-activity-visualizer",
          "title": "Aetheris",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ai-activity-visualizer": [
        {
          "type": "webview",
          "id": "aiActivityVisualizer.controlView",
          "name": "Server & Controls"
        }
      ]
    },
    "commands": [
      {
        "command": "aiActivityVisualizer.openDashboard",
        "title": "Aetheris: Open 3D Observatory",
        "category": "Aetheris"
      },
      {
        "command": "aiActivityVisualizer.startRecording",
        "title": "Aetheris: Start Recording",
        "category": "Aetheris"
      },
      {
        "command": "aiActivityVisualizer.stopRecording",
        "title": "Aetheris: Stop Recording",
        "category": "Aetheris"
      },
      {
        "command": "aiActivityVisualizer.pauseRecording",
        "title": "Aetheris: Pause Recording",
        "category": "Aetheris"
      },
      {
        "command": "aiActivityVisualizer.resumeRecording",
        "title": "Aetheris: Resume Recording",
        "category": "Aetheris"
      },
      {
        "command": "aiActivityVisualizer.clearSession",
        "title": "Aetheris: Clear Current Session",
        "category": "Aetheris"
      },
      {
        "command": "aiActivityVisualizer.exportSession",
        "title": "Aetheris: Export Current Session",
        "category": "Aetheris"
      },
      {
        "command": "aiActivityVisualizer.configureCopilot",
        "title": "Aetheris: Configure Copilot Integration",
        "category": "Aetheris"
      },
      {
        "command": "aiActivityVisualizer.configureAntigravity",
        "title": "Aetheris: Configure Antigravity Integration",
        "category": "Aetheris"
      },
      {
        "command": "aiActivityVisualizer.validateIntegrations",
        "title": "Aetheris: Validate Integrations",
        "category": "Aetheris"
      },
      {
        "command": "aiActivityVisualizer.openPrivacySettings",
        "title": "Aetheris: Open Privacy Settings",
        "category": "Aetheris"
      },
      {
        "command": "aiActivityVisualizer.showDiagnostics",
        "title": "Aetheris: Show Diagnostics & Logs",
        "category": "Aetheris"
      }
    ],
    "configuration": {
      "title": "Aetheris",
      "properties": {
        "aiActivityVisualizer.recordingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether to record workspace and agent activity automatically on startup."
        },
        "aiActivityVisualizer.retentionDays": {
          "type": "number",
          "default": 30,
          "description": "Maximum number of days to retain activity history in SQLite database."
        },
        "aiActivityVisualizer.maxEventsPerSession": {
          "type": "number",
          "default": 20000,
          "description": "Maximum number of events stored per session."
        },
        "aiActivityVisualizer.graphNodeLimit": {
          "type": "number",
          "default": 1000,
          "description": "Maximum number of file nodes rendered in constellation graph."
        },
        "aiActivityVisualizer.enableContentCapture": {
          "type": "boolean",
          "default": false,
          "description": "Explicit opt-in to capture limited source code diff snippets."
        },
        "aiActivityVisualizer.enabledAdapters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["vscode", "copilot", "antigravity", "http"],
          "description": "List of enabled agent and workspace ingestion adapters."
        },
        "aiActivityVisualizer.httpReceiverPort": {
          "type": "number",
          "default": 5174,
          "description": "Loopback port for local event receiver."
        },
        "aiActivityVisualizer.excludedPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/*.secret",
            "**/.env*",
            "**/id_rsa*",
            "**/*.pem",
            "**/*.key"
          ],
          "description": "Glob patterns of files and directories excluded from monitoring and graph nodes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./ --noEmit",
    "build:extension": "node esbuild.config.mjs",
    "build:webview": "node esbuild.webview.mjs",
    "build": "node esbuild.config.mjs && node esbuild.webview.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --no-rewrite-relative-links",
    "setup": "node ./scripts/setup.mjs",
    "start": "node live_bridge_server.mjs --open"
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
